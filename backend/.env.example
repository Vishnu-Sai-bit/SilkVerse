# ==============================================
# SilkVerse Backend Environment Configuration
# Copy this file to .env and fill in your values
# ==============================================

# Server Port
PORT=5001

# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/silkverse

# JWT Authentication Secret (at least 32 characters)
JWT_SECRET=silkverse_super_secret_jwt_key_change_in_production

# Frontend Client URL (for CORS & Redirects)
CLIENT_URL=http://localhost:3001

# Razorpay Payment Gateway Credentials (Optional for local COD testing)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMTP / Transactional Email Configuration (Optional — falls back to console OTP in dev)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
